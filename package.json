{
  "name": "@tzaban/react-sortable-tree",
  "version": "0.1.0",
  "description": "A modern, type-safe React component for drag-and-drop sortable representation of hierarchical data",
  "type": "module",
  "main": "./dist/react-sortable-tree.umd.js",
  "module": "./dist/react-sortable-tree.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzaban/react-sortable-tree.git"
  },
  "keywords": [
    "react",
    "tree",
    "sortable",
    "drag-and-drop",
    "typescript",
    "tailwindcss"
  ],
  "author": "Guy Tzaban",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tzaban/react-sortable-tree/issues"
  },
  "homepage": "https://github.com/tzaban/react-sortable-tree#readme",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "zustand": "^4.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.2"
  }
}
